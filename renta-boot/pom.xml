<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.renta</groupId>
        <artifactId>renta-herramientas-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>renta-boot</artifactId>
    <packaging>war</packaging>
    <name>Renta Herramientas - Boot &amp; Packaging</name>
    <description>Modulo Ejecutable: Configuracion Spring Boot, Apache Tomcat (Embebido y WAR Nativo)</description>

    <dependencies>
        <dependency>
            <groupId>com.renta</groupId>
            <artifactId>renta-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.renta</groupId>
            <artifactId>renta-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.renta</groupId>
            <artifactId>renta-infrastructure</artifactId>
        </dependency>

        <!-- Tomcat embebido marcado como provided para permitir despliegue nativo en Tomcat 10+ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Boot Actuator (Observabilidad, Health Checks y Métricas) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>renta-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
